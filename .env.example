# Namuna. Haqiqiy qiymatlarni .env ga yozing yoki Railway > Variables ga qo'ying.
# Bu fayl git'ga tushadi, .env esa TUSHMAYDI — shuning uchun bu yerda qiymat yo'q.

# --- Majburiy ---
BOT_TOKEN=
CHANNEL=@kanalingiz
ALLOWED_USERNAMES=username1,username2

# --- To'lov ---
CARD_NUMBER=
CARD_HOLDER=
PREPAY_SHARE=0.7

# --- Mini App (GitHub Pages manzili) ---
WEBAPP_URL=

# --- Ixtiyoriy ---
BRAND_LABEL=Original
MAX_IMAGES=12
ORDER_TIMEOUT_MINUTES=30
# CBU'ga ulanib bo'lmasa ishlatiladigan zaxira kurs
CNY_RATE=1761
# MKExpress tariflari (so'm/kg)
AVTO_KARGO_RATE=83880
AVIA_BREND_RATE=156000

# Ma'lumot fayllari papkasi. Railway'da Volume yo'li: /data
DATA_DIR=
