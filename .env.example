# Namuna. Haqiqiy qiymatlarni .env ga yozing yoki Railway > Variables ga qo'ying.
# Bu fayl git'ga tushadi, .env esa TUSHMAYDI — shuning uchun bu yerda qiymat yo'q.

# --- Majburiy ---
BOT_TOKEN=
CHANNEL=@kanalingiz
ALLOWED_USERNAMES=username1,username2

# --- Xabarnomalar ---
# Savol va tugallanmagan buyurtma xabarlari shu ID'ga keladi.
# Bo'sh qoldirsangiz, bot ID'ni admin unga yozganda o'zi eslab qoladi —
# lekin yangi serverda birinchi xabarlar yo'qolib ketishi mumkin.
# Bir nechta admin bo'lsa: ADMIN_IDS=111,222
ADMIN_ID=

# --- To'lov ---
CARD_NUMBER=
CARD_HOLDER=
PREPAY_SHARE=0.7

# --- Mini App (GitHub Pages manzili) ---
WEBAPP_URL=

# --- Sayt API'si (api.py) ---
# Railway PORT'ni o'zi beradi — u yerda hech narsa yozish shart emas,
# faqat Settings > Networking > Generate Domain qiling.
# Kompyuterda yoqish uchun:
API_PORT=
# Faqat shu sayt o'qiy olsin (bo'sh — hamma):
SITE_ORIGIN=
# Rasm havolalari uchun tashqi manzil (odatda kerak emas):
API_PUBLIC_URL=

# --- Ixtiyoriy ---
BRAND_LABEL=Original
MAX_IMAGES=12
ORDER_TIMEOUT_MINUTES=30
# CBU'ga ulanib bo'lmasa ishlatiladigan zaxira kurs
CNY_RATE=1761
# MKExpress tariflari (so'm/kg)
AVTO_KARGO_RATE=83880
AVIA_BREND_RATE=156000

# Ma'lumot fayllari papkasi. Railway'da Volume yo'li: /data
DATA_DIR=
